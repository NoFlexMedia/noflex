package noflex:plugin@0.2.0;

/// Remote metadata provider — fetches metadata from external sources
/// (TMDb, TVDB, MusicBrainz, AniDB, ...). Multiple providers compete via the
/// host's priority registry; the highest-priority candidate's `fetch` is used
/// in full. Lower-priority providers are *only* consulted as fallbacks when
/// the primary `fetch` fails. Provider-exclusive — fields are never merged
/// across providers in v1.
interface metadata {
    use types.{
        search-query, metadata-match, metadata-payload, provider-attribution,
        external-id, work-id, work-kind, plugin-error,
    };

    /// How to credit this provider, or `none` if it asks for no credit. Read
    /// once per load and kept by the host, so a title stays credited after
    /// the plugin is removed. Covers everything the plugin supplies, artwork
    /// from its `image` hook included. Pure and non-blocking, as `supports` is.
    attribution: func() -> option<provider-attribution>;

    /// Capability claim — does this provider produce metadata for the
    /// given kind? Called at registration time, not per request. Pure and
    /// non-blocking, so deliberately not `async`.
    supports: func(kind: work-kind) -> bool;

    search: async func(query: search-query) -> result<list<metadata-match>, plugin-error>;

    fetch: async func(id: external-id) -> result<metadata-payload, plugin-error>;

    /// Fetch metadata for the children of a work (seasons for a series,
    /// episodes for a season). Default: return empty so providers can opt out.
    fetch-children: async func(parent: external-id, parent-work: work-id)
        -> result<list<metadata-payload>, plugin-error>;
}

/// Image provider — returns binary image bytes plus metadata.
///
/// Payloads cross the boundary as a `stream<u8>`; the host reads the
/// stream to completion into a contiguous buffer because upper layers
/// (cache, GraphQL) keep `Vec<u8>`. The host enforces a per-call memory cap
/// (manifest-overridable) so a misbehaving plugin streaming a multi-GB blob
/// is killed by the resource limiter rather than OOMing the server.
interface image {
    use types.{external-id, image-kind, image-meta, plugin-error};

    /// One image a provider offers for a record, for an administrator
    /// choosing artwork by hand.
    record image-candidate {
        /// Plugin-owned and opaque. The host hands it back to
        /// `fetch-candidate` unchanged and never reads it, so a plugin may
        /// encode whatever it needs to fetch the image again.
        handle: string,
        kind: image-kind,
        /// ISO 639-1 code of the text on the image; none when text-free.
        language: option<string>,
        width: option<u32>,
        height: option<u32>,
        /// The provider's own rating of the image, higher is better. The
        /// host only compares scores from one provider.
        score: option<f32>,
    }

    /// The best `kind` image of the record `id` names, in `language` when
    /// the provider has it. `id` may also be one of a person's ids from
    /// `metadata-person.external-ids`, with `kind` `primary` for their photo.
    fetch: async func(
        id: external-id,
        kind: image-kind,
        language: option<string>,
    ) -> result<tuple<image-meta, stream<u8>>, plugin-error>;

    /// Every `kind` image the provider has for the record `id` names, best
    /// first. Empty when it has none; `not-found` only for an unknown record.
    list-candidates: async func(id: external-id, kind: image-kind)
        -> result<list<image-candidate>, plugin-error>;

    /// The image a `list-candidates` answer's `handle` names. `preview`
    /// asks for a small rendition, a few hundred pixels across, for a
    /// picker's grid; otherwise the full-size original.
    fetch-candidate: async func(handle: string, preview: bool)
        -> result<tuple<image-meta, stream<u8>>, plugin-error>;
}

/// Online subtitle search (OpenSubtitles, ...). When a viewer asks, the host
/// searches every subtitle plugin at once, and keeps what they download in
/// its own cache: plugins never see the file, nor where a subtitle is kept.
interface subtitle {
    use types.{external-id, work-kind, plugin-error};

    /// Everything the host knows about the file being searched for. A hash
    /// match is the surest, but plenty of files have none, so a provider
    /// should also search by ids and then by title.
    record subtitle-query {
        /// OpenSubtitles' moviehash: 16 lowercase hex digits of the file's
        /// size plus the wrapping sum of its first and last 64 KiB read as
        /// little-endian u64s. None for a file under 64 KiB, or one the host
        /// couldn't read.
        moviehash: option<string>,
        /// In bytes.
        file-size: u64,
        /// The file's name, without its folders.
        file-name: string,
        title: string,
        year: option<s32>,
        kind: work-kind,
        /// The work's own ids; an episode's are the episode's.
        external-ids: list<external-id>,
        /// For an episode, its series' ids, and its season and episode
        /// numbers. Empty and none otherwise.
        series-external-ids: list<external-id>,
        season: option<u32>,
        episode: option<u32>,
        /// Wanted languages as ISO 639-2/T codes (`eng`, `deu`, `zho`); any
        /// language when empty.
        languages: list<string>,
    }

    record subtitle-match {
        /// Opaque to the host, which hands it back to `download`.
        handle: string,
        /// ISO 639-2/T, as in the query.
        language: string,
        /// BCP 47 where the provider tells regions apart (`pt-BR`).
        locale: option<string>,
        /// `srt`, `vtt`, `ass` or `ssa`: what `download` returns.
        format: string,
        /// The release it was timed for, as the uploader named it.
        release: option<string>,
        hearing-impaired: bool,
        /// Only the parts in another language than the audio.
        forced: bool,
        /// Found by the query's moviehash, so timed for this exact file.
        hash-match: bool,
        download-count: option<u64>,
        /// The provider's own rating; higher is better.
        score: option<f32>,
    }

    /// Matches in any order; the host ranks them. `rate-limited` carries the
    /// seconds until the provider will answer again.
    search: async func(query: subtitle-query) -> result<list<subtitle-match>, plugin-error>;

    /// The subtitle behind a handle `search` returned, with its format
    /// (`srt`, `vtt`, `ass` or `ssa`). The host reads the stream to
    /// completion, up to 8 MiB. A used-up download quota is `rate-limited`,
    /// with the seconds until it resets.
    download: async func(handle: string) -> result<tuple<string, stream<u8>>, plugin-error>;
}

/// Runs after a library scan completes, with the works it added, updated and
/// removed. Use for: rebuilding caches, tagging new titles, syncing
/// collections, or a notifier's digest of what arrived.
interface post-scan {
    use types.{library-id, work-id, plugin-error};

    on-scan-complete: async func(
        library: library-id,
        added: list<work-id>,
        updated: list<work-id>,
        removed: list<work-id>,
    ) -> result<_, plugin-error>;
}

/// Per-user account linking (Trakt-style OAuth). The plugin owns the
/// provider dance; the host owns token storage — plugins never persist
/// per-user tokens themselves, they hand them to the host at link time
/// and read them back through `host-secrets.read-for-user`. Every call
/// acts for its `user`.
interface user-link {
    use types.{user-id, plugin-error};

    record link-challenge {
        /// URL the user opens out-of-band to authorize access
        /// (OAuth authorize or device-code page).
        auth-url: string,
        /// Opaque state the host echoes back to `link-complete` when the
        /// provider redirects. The host binds it to the linking user.
        state: string,
        /// The code a device flow asks the user to enter at `auth-url`;
        /// none for a redirect flow.
        user-code: option<string>,
    }

    record user-secret {
        key: string,
        value: string,
    }

    /// Begin a link for `user`; the host shows `auth-url` to them.
    link-start: async func(user: user-id) -> result<link-challenge, plugin-error>;

    /// Finish a link. `callback-query` is the raw query string the
    /// provider's redirect delivered to the host's callback route, so the
    /// plugin can do its code exchange. The returned secrets are persisted
    /// host-side under this user; an empty list means "linked, nothing to
    /// store" (e.g. device-flow plugins that poll out-of-band and hand the
    /// tokens over later).
    link-complete: async func(
        user: user-id,
        state: string,
        callback-query: string,
    ) -> result<list<user-secret>, plugin-error>;

    /// `user` is unlinking: abandon any link they have in progress and,
    /// best-effort, revoke their grant upstream. Their secrets are still
    /// readable during the call; the host deletes them once it returns,
    /// whatever it returns, and stops their background chains first.
    unlink: async func(user: user-id) -> result<_, plugin-error>;
}

/// Interactive authentication through a verified external identity provider.
/// The host owns state and PKCE material; the guest owns provider discovery,
/// token exchange, and the HTTPS UserInfo request.
interface external-auth {
    use types.{plugin-error};

    record verified-identity {
        issuer: string,
        subject: string,
        preferred-username: option<string>,
        display-name: option<string>,
        email: option<string>,
    }

    start: async func(
        callback-uri: string,
        state: string,
        pkce-challenge: string,
    ) -> result<string, plugin-error>;

    complete: async func(
        callback-uri: string,
        code: string,
        pkce-verifier: string,
    ) -> result<verified-identity, plugin-error>;
}

/// Receives lifecycle and library events. Notifier plugins re-emit as
/// user-facing notifications (Gotify, Slack, Discord, etc.). They also see
/// plugin-lifecycle events so a Discord notifier can ping admins when a new
/// plugin appears in the search path.
interface notifier {
    use types.{notify-event, plugin-error};

    notify: async func(event: notify-event) -> result<_, plugin-error>;
}

/// Per-user scrobbling (Trakt, ...). Events derive from the domain bus:
/// playback-session start, pause and resume, progress-at-stop, and manual
/// mark-played. The host enriches each event from storage, so
/// the plugin's only lookup is `host-secrets.read-for-user` for the
/// acting user's token; users who never linked are skipped.
interface scrobbler {
    use types.{scrobble-event, plugin-error};

    scrobble: async func(event: scrobble-event) -> result<_, plugin-error>;
}

/// Host-scheduled background work. Guests cannot run unprompted — a
/// component only executes while the host is driving a call — so periodic
/// work is registered declaratively in the manifest (`[[tasks]]`: name,
/// interval, optional static payload) and the host invokes `run-task` on
/// the plugin's single instance. Background calls ride the same instance
/// as foreground hooks: plugin state stays single-threaded-coherent and
/// there is no second dispatch path.
interface background {
    use types.{plugin-error, task-outcome};

    /// `cursor` is the guest-owned value the previous invocation returned
    /// via `more(...)` (`none` on the first run). `payload` is the
    /// manifest's static payload for scheduled invocations, or the value a
    /// hook passed to `host-tasks.enqueue` for dynamic ones.
    run-task: async func(
        task: string,
        cursor: option<string>,
        payload: option<string>,
    ) -> result<task-outcome, plugin-error>;
}

/// Text embedding provider, which stands aside if an administrator configures
/// an embeddings API. The host embeds work
/// texts while the host is idle and query text at search time and persists
/// the vectors itself — plugins still never see storage. The vector
/// namespace, model id, and dimensionality are claimed statically in the
/// manifest's `[embedding]` table, not negotiated per call.
interface embedder {
    use types.{plugin-error};

    /// A work's text, split the way retrieval models want it.
    record embed-document {
        title: string,
        /// Empty when only the title is known.
        text: string,
    }

    /// What's being embedded. Retrieval models embed the two sides of a
    /// search differently, so a query and a document with the same words
    /// need not get the same vector.
    variant embed-input {
        query(string),
        document(embed-document),
    }

    /// One vector per input, in input order; every vector must have the
    /// manifest-claimed dimensionality (the host rejects the call otherwise).
    /// Batch size is host-capped.
    embed: async func(inputs: list<embed-input>) -> result<list<list<f32>>, plugin-error>;
}

/// Ratings provider — adds ratings to works another provider described
/// (OMDb's IMDb, Rotten Tomatoes and Metacritic scores, ...). After applying
/// a work's metadata, whichever provider supplied it, the host asks every
/// ratings plugin at once with the ids that metadata left the work with,
/// and keeps each plugin's answer apart: one that fails keeps what it
/// reported last time and changes nothing else. A metadata provider reports
/// its own ratings in `metadata-payload.ratings` and needs no such export.
interface ratings {
    use types.{external-id, work-kind, rating, provider-attribution, plugin-error};

    /// How to credit this provider, as `metadata.attribution`. Read once per
    /// load; pure and non-blocking.
    attribution: func() -> option<provider-attribution>;

    /// Every rating the provider has for the `kind` work `ids` name, one per
    /// source; the answer replaces this provider's last. Empty when none of
    /// `ids` is one it can look up, or it has no rating of the work.
    fetch: async func(ids: list<external-id>, kind: work-kind)
        -> result<list<rating>, plugin-error>;
}
