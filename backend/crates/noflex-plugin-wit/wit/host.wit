package noflex:plugin@0.2.0;

/// Structured logging from the plugin into the host's tracing subscriber.
/// Logs appear in the same process output as the rest of the server,
/// namespaced as `noflex_plugin::<plugin_id>::<namespace>`. Standard
/// `RUST_LOG` filter syntax applies.
///
/// `audit` is special: it routes to a dedicated audit-log appender regardless
/// of namespace, so security-relevant events stay grep-able even when
/// operational logs are filtered down.
/// `log` is sync on purpose: it feeds the host's tracing subscriber, which
/// never blocks the caller. `host-secrets` (file I/O) and `host-library`
/// (storage round-trip) are the imports that can block and are `async`.
interface host-log {
    enum level {
        trace,
        debug,
        info,
        warn,
        error,
        audit,
    }

    log: func(
        level: level,
        namespace: string,
        message: string,
        fields: list<tuple<string, string>>,
    );
}

/// Read a secret declared in the plugin manifest. The host enforces that
/// only keys listed in the manifest's `secrets_read` array are accessible;
/// anything else returns `plugin-error::capability-denied`. Secret values
/// are opaque strings; the plugin parses as it sees fit.
///
/// Storage location (v1, cleartext):
///   - System tier: /etc/noflex/secrets/<plugin_id>.toml
///   - State tier:  /var/lib/noflex/secrets/<plugin_id>.toml
///   - User tier:   $XDG_CONFIG_HOME/noflex/secrets/<plugin_id>.toml
///
/// v2 replaces the cleartext store with age or the system keyring.
interface host-secrets {
    use types.{user-id, plugin-error};

    read: async func(key: string) -> result<string, plugin-error>;

    /// Read a per-user secret stored at `user-link` time (e.g. a Trakt
    /// access token). Keys must be listed in the manifest's
    /// `user_secrets_read` array; anything else is `capability-denied`.
    /// Every read is audit-logged with the user id. There is deliberately
    /// no user-enumeration import — plugins only learn user ids from the
    /// events and task payloads the host hands them.
    ///
    /// Per-user access is bound to the hook call it happens in: `user`
    /// must equal the user that call acts for (`capability-denied`
    /// otherwise), and calls that act for no user get `unavailable`.
    /// `user-link` calls act for their `user` argument, `scrobbler` calls
    /// for the event's user, and a `background` run for the user whose
    /// call enqueued its payload via `host-tasks.enqueue` (continuing
    /// through that run's `more(...)` chain); everything else acts for no
    /// one. Futures a call spawns share its binding.
    read-for-user: async func(user: user-id, key: string) -> result<string, plugin-error>;

    /// Write a per-user secret (e.g. a refreshed OAuth access token).
    /// Keys must be listed in the manifest's `user_secrets_write`
    /// array; anything else is `capability-denied`. The same call-bound
    /// principal rule as `read-for-user` applies. Every write is
    /// audit-logged with the user id and key — never the value.
    write-for-user: async func(user: user-id, key: string, value: string)
        -> result<_, plugin-error>;
}

/// Returns the plugin's own config stanza from the server's `config.toml`,
/// as an opaque TOML string. The plugin parses with whatever TOML library
/// it bundles.
///
/// Config is read-only at instantiation; if the server config changes, the
/// plugin host drains in-flight calls and re-instantiates with the new
/// config — the plugin never sees a config change in flight.
interface host-config {
    read: func() -> string;
}

/// Narrow read-only access to library data. Plugins **never** see the
/// `Storage` trait directly; each query they need is a separate, named host
/// import that the host implements over `Storage`. More are added as
/// concrete use cases arise.
interface host-library {
    use types.{work-id, work-kind, edition-id, external-id};

    record work-summary {
        id: work-id,
        kind: work-kind,
        title: string,
        year: option<s32>,
    }

    record chapter {
        position-ms: s64,
        title: option<string>,
    }

    record edition-summary {
        id: edition-id,
        work-id: work-id,
        name: string,
        runtime-ms: option<s64>,
        chapters: list<chapter>,
        /// Already-persisted markers, so detectors can skip or refine.
        intro-start-ms: option<s64>,
        intro-end-ms: option<s64>,
        credits-start-ms: option<s64>,
    }

    lookup-work-by-id: async func(id: work-id) -> option<work-summary>;

    lookup-edition-by-id: async func(id: edition-id) -> option<edition-summary>;

    /// Every work carrying `id` among its external ids. `value` is matched
    /// exactly as metadata providers store it, which for TMDb and TheTVDB
    /// is a path (`movie/603`, `tv/1399`, `series/81189`); IMDb ids are
    /// bare (`tt0133093`).
    find-works: async func(id: external-id) -> list<work-summary>;

    /// The episode numbered `episode` in season `season` (`0` for specials)
    /// of the first series carrying any of `series-ids`, matched as
    /// `find-works` matches. A multi-episode file counts for every number
    /// it spans.
    find-episode: async func(series-ids: list<external-id>, season: u32, episode: u32)
        -> option<work-summary>;
}

/// Tags a plugin owns. Requires the `library.tags.write` capability, and a
/// namespace the manifest claims in `tag_namespaces`; the host refuses to
/// load a plugin claiming a core namespace (`genre`, `person`, ...) or one
/// another loaded plugin claims. Every write is audit-logged. Tags show to
/// everyone who can see the title, like any other tag in the namespace.
interface host-tags {
    use types.{work-id, plugin-error};

    record tag-draft {
        /// Lowercase ASCII letters, digits and `-`, at most 128 bytes;
        /// unique within the namespace.
        slug: string,
        /// What clients show; at most 256 bytes.
        display: string,
        /// How strongly the tag applies, in [0.0, 1.0].
        weight: f32,
    }

    /// Replace this plugin's tags in `namespace` on `work` with `tags`, at
    /// most 500. Repeating a call changes nothing, so a retried task can
    /// send it again. `not-found` when `work` doesn't exist.
    set-tags: async func(work: work-id, namespace: string, tags: list<tag-draft>)
        -> result<_, plugin-error>;
}

/// Collections a plugin owns. Requires the `library.collections.write`
/// capability; every write is audit-logged.
interface host-collections {
    use types.{work-id, plugin-error};

    /// Create or replace the collections this plugin keeps under `key`
    /// (unique per plugin, at most 128 bytes). Collections are
    /// library-scoped, so a list spanning libraries becomes one collection
    /// per library under the same key, each with its works in list order;
    /// works that don't exist are skipped, and at most 500 may be sent. A
    /// library the list no longer reaches loses its collection, so an empty
    /// list deletes them all. An administrator can detach a collection,
    /// making it theirs: the plugin then never writes that key in that
    /// library again. Returns how many collections the key has now.
    sync-collection: async func(
        key: string,
        title: string,
        overview: option<string>,
        works: list<work-id>,
    ) -> result<u32, plugin-error>;
}

/// A user's watch state: what they played and when, their ratings and
/// favorites. Per-user like `host-secrets.read-for-user`: `user` must be
/// the user the calling hook acts for (`capability-denied` otherwise,
/// `unavailable` in a call acting for no one). Reading requires
/// `user-state.read`, importing `user-state.write`; every call is
/// audit-logged with the user id.
interface host-user-state {
    use types.{user-id, work-id, work-kind, external-id, plugin-error};

    /// Milliseconds since the Unix epoch, UTC.
    type timestamp = s64;

    record user-rating {
        /// On a 0–10 scale.
        value: f32,
        rated-at: timestamp,
    }

    record history-entry {
        work: work-id,
        kind: work-kind,
        /// The work's provider ids, as `host-library.find-works` takes them.
        external-ids: list<external-id>,
        /// For an episode, its series' ids, season and number.
        series-external-ids: list<external-id>,
        season-number: option<u32>,
        episode-number: option<u32>,
        /// When last played to the end; none when unplayed.
        played-at: option<timestamp>,
        play-count: u32,
        rating: option<user-rating>,
        favorite: bool,
    }

    record history-page {
        entries: list<history-entry>,
        /// Pass back as `cursor` for the next page; none on the last.
        next-cursor: option<string>,
    }

    /// A page of up to 500 of `user`'s titles that are played, rated or
    /// favorited, or with `since`, only those played or rated at or after
    /// it. A play, rating or favorite this plugin imported is left out (a
    /// title left with nothing is skipped), so a sync never reads its own
    /// imports back as new: what remains happened here or came from
    /// elsewhere.
    user-history: async func(user: user-id, since: option<timestamp>, cursor: option<string>)
        -> result<history-page, plugin-error>;

    record state-import {
        work: work-id,
        /// When it was last played to the end, if it was.
        played-at: option<timestamp>,
        /// How many times, when known; at least one with `played-at`.
        play-count: option<u32>,
        rating: option<user-rating>,
        /// Only `true` changes anything.
        favorite: bool,
    }

    /// Apply up to 500 `items` to `user`'s state. Imports only add: a play
    /// counts when it is newer than the recorded one, a rating when its
    /// time is, and a favorite when set; nothing is ever un-played,
    /// un-rated or un-favorited, and the play count becomes the larger of
    /// the two, so importing the same history twice changes nothing. A play
    /// within an hour of the recorded one is the same viewing reported
    /// twice, and becomes the import's. Works the user can't see are skipped. Imported state is never sent to
    /// scrobblers or notifiers as if it had just been played. Returns how
    /// many titles changed.
    import-user-state: async func(user: user-id, items: list<state-import>)
        -> result<u32, plugin-error>;
}

/// Dynamic follow-up work. Any hook call may enqueue a `background`
/// invocation for its own plugin (post-scan → intro sweep over the added
/// works); the host persists the payload and drains the queue on the
/// plugin's instance, FIFO per task. Payloads are opaque strings (JSON by
/// convention) and survive instance recycling and host restarts. The host
/// also records which user, if any, the enqueuing call acted for, and runs
/// the task bound to that user (see `host-secrets.read-for-user`).
interface host-tasks {
    use types.{plugin-error};

    enqueue: async func(task: string, payload: option<string>) -> result<_, plugin-error>;
}

/// Plugin-emitted metrics. Bridged into whatever metrics exporter the server
/// is configured with (Prometheus, OTLP, ...). No-op when no exporter is
/// configured.
///
/// Metric names are namespaced by the host as `noflex_plugin_<plugin_id>_<name>`
/// to prevent collisions across plugins.
interface host-metrics {
    histogram: func(name: string, value: f64);
    counter: func(name: string, delta: u64);
}

/// Read-only access to host-managed asset files (embedding models,
/// tokenizers, vocabularies, ...). Narrow and named like every other
/// host import: the guest requests a file by relative name, the host
/// resolves it under the configured plugin-assets directory (absolute
/// paths and `..` traversal are rejected), caps the size, and
/// audit-logs reads. Requires the `assets.read` capability.
interface host-assets {
    use types.{plugin-error};

    /// Returns the full file contents. Large assets (model weights) are
    /// expected — guests should request them once and cache in instance
    /// state rather than re-reading per call.
    read-file: async func(name: string) -> result<list<u8>, plugin-error>;
}

/// Native model inference. WASM has no access to the vector instructions and
/// accelerators a transformer needs to be usable, so the guest brings the
/// tokenizer and the understanding of the model, and the host runs the graph.
/// Requires the `inference.run` capability; every model load is audit-logged.
interface host-inference {
    use types.{plugin-error};

    /// Run the embedding model stored at asset path `model`, an ONNX graph taking
    /// `input_ids` and `attention_mask` with a `sentence_embedding` output, over a
    /// batch of token sequences: one vector out per sequence, in order. The host
    /// pads and masks, and chooses the device. Loads the model on first use and keeps it loaded. Slow
    /// by host-call standards; size the hook's deadline for a slow CPU.
    embed-tokens: async func(
        model: string,
        tokens: list<list<u32>>,
    ) -> result<list<list<f32>>, plugin-error>;
}

/// Host-performed HTTP egress. Guests on `wasm32-wasip2` have no socket
/// access, so outbound HTTP (webhooks, scrobblers, upstream metadata
/// APIs) goes through the host, which performs the request on the
/// plugin's behalf. Requires the `http.egress` capability; the URL's
/// host must also match the manifest's `http_egress_hosts` allowlist —
/// exact case-insensitive match, a `*.suffix` entry matching subdomains
/// of `suffix` (not the apex), or a bare `*` matching anything (the host
/// warns at load when a plugin requests unrestricted egress).
///
/// Only `http` and `https` URLs are accepted. Redirects are never
/// followed — a 3xx is returned to the guest as-is, so the plugin sees
/// exactly what the upstream answered. Request bodies are host-capped
/// (4 MiB) and response bodies are truncated at a host cap (16 MiB,
/// an `internal` error past it), so one call can't OOM the host.
/// Every request — allowed or denied — is audit-logged with the final
/// status code (origin plus a digest of path and query; never the full
/// URL, which may carry webhook tokens).
///
/// Destination addresses are vetted at connect time, after DNS: unless
/// the manifest also declares `http.private-network`, the host refuses
/// loopback, private, link-local, CGNAT, and other special-purpose ranges
/// (including IPv6 forms embedding such IPv4 addresses) with
/// `capability-denied`, and refuses a name whose answers mix public and
/// forbidden addresses. IP-literal URLs get the same check. Proxy
/// environment variables are ignored.
interface host-net {
    use types.{plugin-error};

    record http-request {
        /// One of GET, POST, PUT, PATCH, DELETE, HEAD.
        method: string,
        url: string,
        /// Hop-by-hop and host-override headers (`host`,
        /// `content-length`, `connection`, `transfer-encoding`,
        /// `keep-alive`, `upgrade`) are stripped by the host.
        headers: list<tuple<string, string>>,
        body: option<list<u8>>,
        /// Per-request timeout in milliseconds. Default 30s when unset;
        /// values above the 120s host ceiling are clamped to it.
        timeout-ms: option<u32>,
    }

    record http-response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    request: async func(req: http-request) -> result<http-response, plugin-error>;
}
